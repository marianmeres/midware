{
	"permissions": {
		"allow": ["Bash", "Edit(./**)", "WebFetch", "WebSearch"],
		"ask": [
			"Bash(rm -r*)",
			"Bash(rm -R*)",
			"Bash(rm -fr*)",
			"Bash(rm -fR*)",
			"Bash(git push *--force*)",
			"Bash(git push -f*)",
			"Bash(git push * -f*)",
			"Bash(git reset *--hard*)",
			"Bash(git clean*)",
			"Bash(git checkout -- *)",
			"Bash(git checkout .*)",
			"Bash(git restore *)",
			"Bash(pnpm run release*)",
			"Bash(pnpm run rp*)",
			"Bash(pnpm release*)",
			"Bash(pnpm rp*)",
			"Bash(npx *@marianmeres/release*)",
			"Bash(gh release create*)",
			"Bash(gh repo delete*)"
		],
		"deny": [
			"Bash(pkill*)",
			"Bash(killall*)",
			"Bash(xargs kill*)",
			"Bash(npm publish*)",
			"Bash(pnpm publish*)",
			"Bash(bun publish*)",
			"Bash(npm unpublish*)"
		]
	}
}
